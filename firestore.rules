rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write access to authenticated users for their projects
    match /projects/{projectId} {
      // Allow read if user is a member or owner
      allow read: if request.auth != null && (
        request.auth.token.email in resource.data.members ||
        request.auth.uid == resource.data.owner
      );
      
      // Allow create if user is authenticated
      allow create: if request.auth != null;
      
      // Simple update rule
      allow update: if request.auth != null && (
        // Owner can do anything
        request.auth.uid == resource.data.owner ||
        
        // Members can update members array (for leaving)
        (
          request.auth.token.email in resource.data.members &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        ) ||
        
        // Allow joining via invitation
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
          request.resource.data.members.hasAll(resource.data.members) &&
          request.auth.token.email in request.resource.data.members
        )
      );
      
      // Allow delete if user is owner
      allow delete: if request.auth != null && 
                   request.auth.uid == resource.data.owner;
      
      // Allow read/write access to boards within the project
      match /boards/{boardId} {
        allow read, write: if request.auth != null && 
          request.auth.token.email in get(/databases/$(database)/documents/projects/$(projectId)).data.members;
        
        // Allow read/write access to cards within the board
        match /cards/{cardId} {
          allow read, write: if request.auth != null && 
            request.auth.token.email in get(/databases/$(database)/documents/projects/$(projectId)).data.members;
        }
      }
    }

    // Add rules for invitations collection
    match /invitations/{invitationId} {
      // Allow read for involved parties
      allow read: if request.auth != null && (
        resource.data.toEmail == request.auth.token.email ||
        resource.data.fromEmail == request.auth.token.email
      );
      
      // Allow create for project members
      allow create: if request.auth != null;
      
      // Allow update status by recipient
      allow update: if request.auth != null &&
                   resource.data.toEmail == request.auth.token.email &&
                   request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
                   (request.resource.data.status == "accepted" || request.resource.data.status == "declined");
    }

    // Allow users to manage their own cards
    match /users/{userId}/cards/{cardId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Allow authenticated users to read/write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Add rules for task assignments
    match /projects/{projectId}/boards/{boardId}/cards/{cardId} {
      // Allow read if user is a project member
      allow read: if request.auth != null && 
        request.auth.token.email in get(/databases/$(database)/documents/projects/$(projectId)).data.members;
      
      // Allow create with assignment
      allow create: if request.auth != null && 
        request.auth.token.email in get(/databases/$(database)/documents/projects/$(projectId)).data.members;
      
      // Allow update if user is member and:
      // 1. They're the assignee
      // 2. They're accepting an open task
      // 3. They created the card
      allow update: if request.auth != null && 
        request.auth.token.email in get(/databases/$(database)/documents/projects/$(projectId)).data.members &&
        (
          resource.data.createdBy.email == request.auth.token.email ||
          resource.data.assignment.assignedTo == request.auth.token.email ||
          (
            resource.data.assignment.type == "open" &&
            !resource.data.assignment.acceptedBy &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignment']) &&
            request.resource.data.assignment.acceptedBy == request.auth.token.email
          )
        );
    }
  }
}
