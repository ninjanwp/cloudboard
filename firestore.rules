rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow authenticated users to read other users' display names
    match /users/{userId} {
      allow read: if request.auth != null;  // Allow all authenticated users to read user profiles
      allow write: if request.auth != null && 
                  request.auth.uid == userId && 
                  request.resource.data.keys().hasOnly(['firstName', 'lastName', 'email']);
      
      // Add this index for email queries
      allow list: if request.auth != null && 
                 request.query.limit <= 1 &&
                 'email' in request.query.filters;
    }

    // Allow read/write access to authenticated users for their projects
    match /projects/{projectId} {
      // Allow read if user is a member, owner, or authenticated (for invitation acceptance)
      allow read: if request.auth != null && (
        request.auth.token.email in resource.data.members ||
        request.auth.uid == resource.data.owner ||
        // Allow authenticated users to read for invitation acceptance
        request.auth.token.email != null
      );
      
      // Allow create if user is authenticated
      allow create: if request.auth != null;
      
      // Proper update rule - based on working March rules with memberRoles support
      allow update: if request.auth != null && (
        // Owner can do anything
        request.auth.uid == resource.data.owner ||
        
        // Members can update members array (for leaving)
        (
          request.auth.token.email in resource.data.members &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        ) ||
        
        // Allow joining via invitation - original simple version (members only)
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
          request.resource.data.members.hasAll(resource.data.members) &&
          request.auth.token.email in request.resource.data.members
        ) ||
        
        // Allow joining via invitation - new version (members + memberRoles)
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberRoles']) &&
          request.resource.data.members.hasAll(resource.data.members) &&
          request.auth.token.email in request.resource.data.members &&
          request.resource.data.members.size() == resource.data.members.size() + 1
        )
      );
      
      // Allow delete if user is owner
      allow delete: if request.auth != null && 
                   request.auth.uid == resource.data.owner;
      
      // Add rules for logs collection under projects
      match /logs/{logId} {
        allow read, create: if request.auth != null && 
          request.auth.token.email in get(/databases/$(database)/documents/projects/$(projectId)).data.members;
      }

      // Add rules for chat collection under projects
      match /chat/{messageId} {
        allow read: if request.auth != null && 
          request.auth.token.email in get(/databases/$(database)/documents/projects/$(projectId)).data.members;
        
        allow create: if request.auth != null && 
          request.auth.token.email in get(/databases/$(database)/documents/projects/$(projectId)).data.members &&
          request.resource.data.sender == request.auth.token.email;
      }

      // Add rules for typing indicators
      match /typing/{userId} {
        allow read: if request.auth != null && 
          request.auth.token.email in get(/databases/$(database)/documents/projects/$(projectId)).data.members;
        
        allow create, update: if request.auth != null && 
          request.auth.token.email in get(/databases/$(database)/documents/projects/$(projectId)).data.members &&
          userId == request.auth.token.email;
        
        allow delete: if request.auth != null && 
          request.auth.token.email in get(/databases/$(database)/documents/projects/$(projectId)).data.members &&
          userId == request.auth.token.email;
      }

      // Allow read/write access to boards within the project
      match /boards/{boardId} {
        allow read, write: if request.auth != null && 
          request.auth.token.email in get(/databases/$(database)/documents/projects/$(projectId)).data.members;
        
        // Allow read/write access to cards within the board
        match /cards/{cardId} {
          allow read, write: if request.auth != null && 
            request.auth.token.email in get(/databases/$(database)/documents/projects/$(projectId)).data.members;
        }
      }
    }

    // Add rules for invitations collection
    match /invitations/{invitationId} {
      // Allow read for involved parties
      allow read: if request.auth != null && (
        resource.data.toEmail == request.auth.token.email ||
        resource.data.fromEmail == request.auth.token.email
      );
      
      // Allow create for project members
      allow create: if request.auth != null;
      
      // Allow update status by recipient
      allow update: if request.auth != null &&
                   resource.data.toEmail == request.auth.token.email &&
                   request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
                   (request.resource.data.status == "accepted" || request.resource.data.status == "declined");
    }

    // Allow users to manage their own cards
    match /users/{userId}/cards/{cardId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Add rules for task assignments
    match /projects/{projectId}/boards/{boardId}/cards/{cardId} {
      // Allow read if user is a project member
      allow read: if request.auth != null && 
        request.auth.token.email in get(/databases/$(database)/documents/projects/$(projectId)).data.members;
      
      // Allow create if user is a project member
      allow create: if request.auth != null && 
        request.auth.token.email in get(/databases/$(database)/documents/projects/$(projectId)).data.members;
      
      // Allow update if user is a project member (removed previous restrictions)
      allow update: if request.auth != null && 
        request.auth.token.email in get(/databases/$(database)/documents/projects/$(projectId)).data.members &&
        // Validate assignment structure if it exists
        (!request.resource.data.assignment || (
          request.resource.data.assignment.type in ['assigned', 'open'] &&
          (!request.resource.data.assignment.assignedTo || 
           request.resource.data.assignment.assignedTo is string)
        ));
      
      // Allow delete if user is a project member
      allow delete: if request.auth != null && 
        request.auth.token.email in get(/databases/$(database)/documents/projects/$(projectId)).data.members;
    }
  }
}
